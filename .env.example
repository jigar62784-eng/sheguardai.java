# SheGuard Environment Configuration Example
# Copy to .env or set in your environment / application.yml

# Backend Server Port
SERVER_PORT=8080

# Firebase Service Account Credentials (JSON file path or environment string)
# Download from: Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# or GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=sheguard-safety.appspot.com

# Email Alert Configuration (SMTP for SOS alerts)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-alerts-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-specific-password

# Twilio SMS Alert Provider (Optional for live SMS)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_PHONE=+1234567890

# Routing Service (OSRM endpoint)
OSRM_SERVICE_URL=https://router.project-osrm.org
